# VasoolKaro backend configuration.
# Copy to .env and adjust. Every value has a development default; only
# DATABASE_URL and JWT_SECRET are required in production.

# Application
APP_NAME=VasoolKaro API
ENVIRONMENT=development

# Database (psycopg driver). Supabase is NOT used at runtime.
# Example for a hosted Postgres:
#   DATABASE_URL=postgresql+psycopg://user:password@host.example.com:5432/vasoolkaro
DATABASE_URL=postgresql+psycopg://vasoolkaro:vasoolkaro@localhost:5432/vasoolkaro

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
PASSWORD_RESET_TTL_SECONDS=3600

# Token for /internal/push/dispatch (worker -> API)
INTERNAL_SERVICE_TOKEN=dev-internal-token

# Web Push (optional). Without keys, push dispatch is a logged no-op.
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=
# PUSH_VAPID_SUBJECT=mailto:ops@yourdomain.example

# Email (optional). Without smtp_url, recovery emails are logged, not sent.
# EMAIL_SMTP_URL=smtp://user:password@smtp.example.com:587
EMAIL_FROM=no-reply@vasoolkaro.example

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Abuse controls
RECEIPT_SUBMIT_RATE_LIMIT=12
RECEIPT_SUBMIT_WINDOW_SECONDS=3600
REFERRAL_BONUS_CENTS=500
PAYOUT_MINIMUM_CENTS=500
